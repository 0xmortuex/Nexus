<Window x:Class="Nexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nexus.App.Controls"
        Title="Nexus Optimizer" Height="760" Width="1180"
        Background="{StaticResource BgBrush}">
    <Grid x:Name="Root" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" Y="16"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: app name + mode switch -->
        <DockPanel Grid.Row="0" Margin="12,10,12,0" LastChildFill="False">
            <TextBlock Text="Nexus" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                    Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="{Binding ModeLabel}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Button DockPanel.Dock="Right" Content="{Binding ModeButtonText}" Command="{Binding ToggleModeCommand}"
                    VerticalAlignment="Center"/>
        </DockPanel>

    <TabControl Grid.Row="1" x:Name="Tabs" Margin="8">

        <!-- ================= Dashboard ================= -->
        <TabItem Header="Dashboard">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="10" DataContext="{Binding Dashboard}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource H1}">
                            <Run Text="CPU "/><Run Text="{Binding CpuText, Mode=OneWay}"/>
                        </TextBlock>
                        <controls:SparklineControl Values="{Binding CpuHistory}" Height="120"
                                                   Stroke="{StaticResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource H1}" Margin="0,16,0,8">
                            <Run Text="RAM "/><Run Text="{Binding RamText, Mode=OneWay}"/>
                        </TextBlock>
                        <controls:SparklineControl Values="{Binding RamHistory}" Height="120"
                                                   Stroke="{StaticResource AccentAltBrush}"/>
                        <TextBlock Style="{StaticResource H1}" Margin="0,16,0,8" Text="Per-core load"/>
                        <controls:CoreBarsControl Values="{Binding PerCore}" ECoreMask="{Binding ECoreMask}" Height="90"/>
                        <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                                   Text="Blue bars are P-cores/standard cores, green bars are E-cores."/>

                        <!-- Security is shown as its own line, never folded into the
                             optimization score: "how well tuned" and "is it compromised"
                             are different questions, and averaging them would let a
                             machine with malware read as well-optimized. -->
                        <Border Margin="0,16,0,0" CornerRadius="4" Padding="10" Background="#232A3A">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H1}" Text="Security"/>
                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold"
                                           Text="{Binding SecurityHeadline}"/>
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="{Binding SecurityDetail}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <GroupBox Header="System optimization rating">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <controls:RatingRingControl Width="84" Height="84"
                                                                Score="{Binding RatingScore}"
                                                                Grade="{Binding RatingGrade}"
                                                                Accent="{StaticResource AccentBrush}"/>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="220">
                                        <TextBlock Text="System rating" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding RatingSummary}" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding RatingCategories}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Category}" FontSize="11.5" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="1" Value="{Binding Score, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat={}{0}%}" FontSize="11" TextAlignment="Right"
                                                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Open setup wizard" Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Command="{Binding DataContext.OpenWizardCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Suggested optimizations"
                                  DataContext="{Binding DataContext.Suggestions, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Re-scan" Command="{Binding RefreshCommand}"/>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Width="70" VerticalAlignment="Top"
                                                            Content="{Binding ActionText}" Command="{Binding ApplyCommand}"
                                                            Visibility="{Binding Actionable, Converter={StaticResource BoolToVisibility}}"/>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource DimText}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="System">
                            <StackPanel>
                                <TextBlock Text="{Binding TopologyText}"/>
                                <TextBlock Text="{Binding RulesText}" Margin="0,4,0,0"/>
                                <CheckBox Content="ProBalance (dynamic restraint)"
                                          IsChecked="{Binding ProBalanceEnabled}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Currently restrained">
                            <ListBox ItemsSource="{Binding Restrained}" MinHeight="120" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding ExeName, Mode=OneWay}"/>
                                            <Run Text="{Binding Pid, Mode=OneWay, StringFormat=' (PID {0})'}"
                                                 Foreground="{StaticResource TextDimBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Processes ================= -->
        <TabItem Header="Processes"
                 Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="10" DataContext="{Binding Processes}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220"
                             HorizontalAlignment="Left"/>
                </DockPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding Selected}"
                          VirtualizingPanel.IsVirtualizing="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Process" Width="260" DisplayMemberBinding="{Binding ExeName}"/>
                            <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                            <GridViewColumn Header="CPU %" Width="80" DisplayMemberBinding="{Binding Cpu}"/>
                            <GridViewColumn Header="RAM (MB)" Width="100" DisplayMemberBinding="{Binding RamMb}"/>
                            <GridViewColumn Header="Rule" Width="60" DisplayMemberBinding="{Binding HasRule}"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Set priority (now)">
                                <MenuItem Header="Idle" Command="{Binding SetPriorityCommand}" CommandParameter="Idle"/>
                                <MenuItem Header="Below normal" Command="{Binding SetPriorityCommand}" CommandParameter="BelowNormal"/>
                                <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="Normal"/>
                                <MenuItem Header="Above normal" Command="{Binding SetPriorityCommand}" CommandParameter="AboveNormal"/>
                                <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="High"/>
                            </MenuItem>
                            <MenuItem Header="Set priority (always)">
                                <MenuItem Header="Idle" Command="{Binding SetPriorityAlwaysCommand}" CommandParameter="Idle"/>
                                <MenuItem Header="Below normal" Command="{Binding SetPriorityAlwaysCommand}" CommandParameter="BelowNormal"/>
                                <MenuItem Header="Normal" Command="{Binding SetPriorityAlwaysCommand}" CommandParameter="Normal"/>
                                <MenuItem Header="Above normal" Command="{Binding SetPriorityAlwaysCommand}" CommandParameter="AboveNormal"/>
                                <MenuItem Header="High" Command="{Binding SetPriorityAlwaysCommand}" CommandParameter="High"/>
                            </MenuItem>
                            <MenuItem Header="Restrict cores (now)">
                                <MenuItem Header="P-cores only" Command="{Binding SetAffinityCommand}" CommandParameter="PCoresOnly"/>
                                <MenuItem Header="E-cores only" Command="{Binding SetAffinityCommand}" CommandParameter="ECoresOnly"/>
                                <MenuItem Header="Physical cores only" Command="{Binding SetAffinityCommand}" CommandParameter="PhysicalCoresOnly"/>
                            </MenuItem>
                            <MenuItem Header="Restrict cores (always)">
                                <MenuItem Header="P-cores only" Command="{Binding SetAffinityAlwaysCommand}" CommandParameter="PCoresOnly"/>
                                <MenuItem Header="E-cores only" Command="{Binding SetAffinityAlwaysCommand}" CommandParameter="ECoresOnly"/>
                                <MenuItem Header="Physical cores only" Command="{Binding SetAffinityAlwaysCommand}" CommandParameter="PhysicalCoresOnly"/>
                            </MenuItem>
                            <MenuItem Header="IO priority (now)">
                                <MenuItem Header="Very low" Command="{Binding SetIoPriorityCommand}" CommandParameter="VeryLow"/>
                                <MenuItem Header="Low" Command="{Binding SetIoPriorityCommand}" CommandParameter="Low"/>
                                <MenuItem Header="Normal" Command="{Binding SetIoPriorityCommand}" CommandParameter="Normal"/>
                            </MenuItem>
                            <MenuItem Header="Efficiency mode on" Command="{Binding SetEfficiencyCommand}" CommandParameter="on"/>
                            <MenuItem Header="Efficiency mode off" Command="{Binding SetEfficiencyCommand}" CommandParameter="off"/>
                            <MenuItem Header="Limit CPU to…">
                                <MenuItem Header="10%" Command="{Binding LimitCpuCommand}" CommandParameter="10"/>
                                <MenuItem Header="25%" Command="{Binding LimitCpuCommand}" CommandParameter="25"/>
                                <MenuItem Header="50%" Command="{Binding LimitCpuCommand}" CommandParameter="50"/>
                                <MenuItem Header="75%" Command="{Binding LimitCpuCommand}" CommandParameter="75"/>
                                <MenuItem Header="Remove CPU limit" Command="{Binding ClearCpuLimitCommand}"/>
                            </MenuItem>
                            <MenuItem Header="Launch priority (survives anti-cheat)">
                                <MenuItem Header="High" Command="{Binding SetLaunchPriorityCommand}" CommandParameter="High"/>
                                <MenuItem Header="Above normal" Command="{Binding SetLaunchPriorityCommand}" CommandParameter="AboveNormal"/>
                                <MenuItem Header="Below normal" Command="{Binding SetLaunchPriorityCommand}" CommandParameter="BelowNormal"/>
                                <MenuItem Header="Idle" Command="{Binding SetLaunchPriorityCommand}" CommandParameter="Idle"/>
                                <MenuItem Header="Remove launch priority" Command="{Binding ClearLaunchPriorityCommand}"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Trim working set" Command="{Binding TrimCommand}"/>
                            <MenuItem Header="Remove saved rule" Command="{Binding RemoveRuleCommand}"/>
                            <Separator/>
                            <MenuItem Header="Terminate…" Command="{Binding KillCommand}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Grid>
        </TabItem>

        <!-- ================= Game Mode ================= -->
        <TabItem Header="Game Mode">
            <Grid Margin="10" DataContext="{Binding GameMode}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource H1}" Text="{Binding StatusText}"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Game Mode enabled" IsChecked="{Binding Enabled}" Margin="0,0,16,0"/>
                        <CheckBox Content="Auto-detect fullscreen/borderless games" IsChecked="{Binding AutoDetect}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <Button Content="Force Game Mode for current app" Command="{Binding ForceCommand}" Margin="0,0,8,0"/>
                        <Button Content="End Game Mode" Command="{Binding EndCommand}"/>
                    </StackPanel>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,4,0,8">
                    <TextBlock Text="Add game exe:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddGameCommand}" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding NewGameExe, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <ListView Grid.Row="2" ItemsSource="{Binding Games}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Game" Width="200" DisplayMemberBinding="{Binding ExeName}"/>
                            <GridViewColumn Header="Rating" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding RatingDetail}">
                                            <Border Width="26" Height="20" CornerRadius="5" Background="{StaticResource PanelAltBrush}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding RatingGrade}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding RatingScore, StringFormat={}{0}/100}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextDimBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Enabled" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Soft pinning (CPU sets)" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding UseCpuSets}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Demote hogs" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DemoteBackgroundHogs}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Perf. power plan" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding UsePerformancePowerPlan}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Pause Windows Update" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding PauseWindowsUpdate}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"
                                                Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>

        <!-- ================= Tweaks ================= -->
        <TabItem Header="Tweaks — measure before trusting">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding Tweaks}">
                    <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,10"
                               Text="Every tweak backs up the registry keys it touches (plus a System Restore point once per session) and has a working Undo. The descriptions are honest — benchmark before and after instead of trusting labels."/>

                    <GroupBox Header="System tweaks">
                        <ItemsControl ItemsSource="{Binding Tweaks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Width="70" Content="{Binding ButtonText}"
                                                    Command="{Binding ToggleCommand}" VerticalAlignment="Top"/>
                                            <StackPanel Margin="0,0,10,0">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding EffectivenessLabel}" Style="{StaticResource DimText}"
                                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <Border Width="7" Height="13" CornerRadius="2" Margin="1,0"
                                                                Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=1}"/>
                                                        <Border Width="7" Height="13" CornerRadius="2" Margin="1,0"
                                                                Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=2}"/>
                                                        <Border Width="7" Height="13" CornerRadius="2" Margin="1,0"
                                                                Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=3}"/>
                                                        <Border Width="7" Height="13" CornerRadius="2" Margin="1,0"
                                                                Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=4}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Pros}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource AccentAltBrush}" FontSize="11" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Cons}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource WarnBrush}" FontSize="11"/>
                                                </Grid>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="Debloat — services (disable only, reversible)"
                              Visibility="{Binding DataContext.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Width="80" Content="{Binding ButtonText}"
                                                Command="{Binding ToggleCommand}" VerticalAlignment="Top"/>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="Debloat — telemetry scheduled tasks (disable only, reversible)"
                              Visibility="{Binding DataContext.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Width="80" Content="{Binding ButtonText}"
                                                Command="{Binding ToggleCommand}" VerticalAlignment="Top"/>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="Debloat — preinstalled apps (removal is one-way; nothing is pre-checked)"
                              Visibility="{Binding DataContext.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Checked}">
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding PackageFamily, Mode=OneWay, StringFormat=' ({0})'}"
                                                     Foreground="{StaticResource TextDimBrush}"/>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Remove checked apps…" Command="{Binding RemoveCheckedAppsCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Cleaner — size preview, then confirm">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Scan" Command="{Binding ScanCommand}" Margin="0,0,8,0"/>
                                <Button Content="Clean checked…" Command="{Binding CleanCommand}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding CleanerStatus}" VerticalAlignment="Center"
                                           Style="{StaticResource DimText}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding CleanTargets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Checked}">
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding SizeText, Mode=OneWay, StringFormat=' — {0}'}"
                                                     Foreground="{StaticResource TextDimBrush}"/>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Startup manager (enable/disable only — nothing is deleted)"
                              Visibility="{Binding DataContext.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Button Content="Refresh" Command="{Binding RefreshStartupCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <ListView ItemsSource="{Binding StartupEntries}" MaxHeight="320">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Enabled" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Source" Width="140" DisplayMemberBinding="{Binding Source}"/>
                                        <GridViewColumn Header="Command / path" Width="420" DisplayMemberBinding="{Binding Command}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Memory & Network ================= -->
        <TabItem Header="Memory &amp; Network">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding Tools}" MaxWidth="760" HorizontalAlignment="Left">
                    <GroupBox Header="Standby memory list">
                        <StackPanel>
                            <TextBlock Text="{Binding MemoryStatus}" Style="{StaticResource DimText}" Margin="0,0,0,8"/>
                            <Button Content="Purge standby list now" Command="{Binding PurgeStandbyCommand}"
                                    HorizontalAlignment="Left"/>
                            <CheckBox Content="Auto-purge when free memory is low" IsChecked="{Binding AutoPurgeStandby}"
                                      Margin="0,8,0,0"/>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Purge below free RAM (MB):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding FreeMemoryThresholdMb}" Width="70" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="DNS benchmark &amp; switch (reversible)">
                        <StackPanel>
                            <TextBlock Text="{Binding DnsStatus}" Style="{StaticResource DimText}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Benchmark resolvers" Command="{Binding BenchmarkDnsCommand}" Margin="0,0,8,0"/>
                                <Button Content="Restore previous DNS" Command="{Binding RestoreDnsCommand}"
                                        IsEnabled="{Binding CanRestoreDns}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DnsResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Button DockPanel.Dock="Right" Content="Use" Width="60"
                                                    Command="{Binding DataContext.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Width="110" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Width="120" Text="{Binding Latency}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Servers}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Security (Sentinel) ================= -->
        <TabItem Header="Security" x:Name="SecurityTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding Security}" MaxWidth="980" HorizontalAlignment="Left">

                    <!-- The big switch. One control, plain words, no jargon, no restart.
                         Someone unsure what Nexus is doing to their machine should be
                         able to stop it in one click and see that it stopped. -->
                    <Border CornerRadius="6" Padding="14" Margin="0,0,0,10"
                            Background="#1E2A3D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                    MinWidth="170" Padding="12,8" FontWeight="SemiBold"
                                    Content="{Binding ProtectionButtonText}"
                                    Command="{Binding ToggleProtectionCommand}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding ProtectionHeadline}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ProtectionDetail}" Style="{StaticResource DimText}"
                                           TextWrapping="Wrap" Margin="0,4,12,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="#22304A" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Nexus reports. It does not decide."
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}"
                                       Text="Nothing here is blocked, deleted or quarantined unless you click the button for that exact file. Every finding shows the reasons behind it and a score out of 100, so you can disagree with it. Keep Microsoft Defender switched on — this is a second opinion, not a replacement."/>
                        </StackPanel>
                    </Border>

                    <GroupBox Header="What is actually running">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Parts of this module can fail to start for ordinary reasons — a missing folder, WMI being unavailable, the scanner not being installed. A security tool that looks enabled while silently doing nothing is worse than one that is honestly off, so here is the real state."/>
                            <ItemsControl ItemsSource="{Binding Protection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Width="150" Text="{Binding Name}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Width="60" VerticalAlignment="Center"
                                                       Text="{Binding Active, Converter={StaticResource BoolToOnOff}}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource DimText}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Re-check" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Command="{Binding RefreshProtectionCommand}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Known-good baseline">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Until Nexus knows what good looks like on this machine, it can only ever say &quot;unknown&quot; — even about ordinary signed Windows programs. This records every binary in System32 and Program Files whose digital signature is valid and trusted by Windows, so those stop being reported as unknown. Expect roughly 30,000 files and two to five minutes, depending on how much you have installed. It only ever reads, and you can stop it at any time."/>
                            <Button Content="Build baseline from this PC" HorizontalAlignment="Left"
                                    Command="{Binding BuildBaselineCommand}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Only files with a VALID signature are recorded, which is what stops an already-infected machine adding its own malware to the list. Anything unsigned or badly signed is skipped. Re-run it after big Windows updates. Restore Defaults deletes it."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Known-bad hash list">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="The other half of reputation: hashes that are known malware, so an exact match is identified outright rather than merely looking odd. The box is pre-filled with abuse.ch&apos;s full MalwareBazaar export — public, free, no account, about 42 MB and over a million hashes. You can paste a smaller list, or a file path if you would rather download it yourself."/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="FeedUrlBox" Width="430" Margin="0,0,8,0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding DefaultFeedUrl, Mode=OneTime}"/>
                                <Button Content="Import list" Margin="0,0,8,0"
                                        Command="{Binding ImportFeedCommand}"
                                        CommandParameter="{Binding Text, ElementName=FeedUrlBox}"/>
                                <Button Content="Recent only"
                                        Command="{Binding ImportFeedCommand}"
                                        CommandParameter="{Binding RecentFeedUrl}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="This is the only time Nexus ever reaches the internet, it only happens when you press this button, and it downloads a public list — nothing about your files is ever sent anywhere. If you would rather not let it connect at all, download the file yourself and give it the path instead."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Microsoft Defender — the part that actually blocks">
                        <StackPanel>
                            <TextBlock Text="{Binding DefenderStatus}" Style="{StaticResource DimText}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="Re-check Defender" HorizontalAlignment="Left"
                                    Command="{Binding CheckDefenderCommand}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Nexus checks whether real-time protection is on, whether definitions are current, and which folders and processes Defender has been told to ignore. Adding a broad exclusion is one of the first things an intruder does, and it is invisible unless you go looking. Nexus reports them; it does not change Defender's settings."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Ransomware watch">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Nexus plants hidden tripwire files in your Documents, Pictures, Videos, Music and Desktop folders, and watches for the pattern an encryption run makes — many documents rewritten at once, everything renamed to one new extension, or a ransom note appearing. Nothing on your machine has a reason to touch a tripwire file, so anything that does gets you an immediate warning. Nexus will not stop the program: it cannot do that reliably without a kernel driver, and it would rather tell you clearly than half-block it."/>
                            <Button Content="That was me — reset the watch" HorizontalAlignment="Left"
                                    Command="{Binding DismissRansomwareAlarmCommand}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Restoring a backup or bulk-converting photos looks the same as the start of an encryption run, and only you know which it was. Use this instead of switching the whole thing off after one false alarm."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Who is talking to the internet">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="A snapshot of established connections, taken when you press &quot;Check connections&quot; above. It is not a running record — something that connects and disconnects between checks will not appear here."/>
                            <ItemsControl ItemsSource="{Binding Connections}" MaxHeight="220">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Width="170" Text="{Binding ProcessName}" VerticalAlignment="Center"/>
                                            <TextBlock Width="60" Style="{StaticResource DimText}" VerticalAlignment="Center"
                                                       Text="{Binding Pid, StringFormat=pid {0}}"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding RemoteAddress, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding RemotePort, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Scan">
                        <StackPanel>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="ScanFolderBox" Width="330" Margin="0,0,8,0"
                                         VerticalContentAlignment="Center"/>
                                <Button Content="Scan folder" Margin="0,0,8,0"
                                        Command="{Binding ScanFolderCommand}"
                                        CommandParameter="{Binding Text, ElementName=ScanFolderBox}"/>
                                <Button Content="Quick check" Margin="0,0,8,0"
                                        ToolTip="Downloads, temp and startup folders — the places things arrive."
                                        Command="{Binding QuickScanCommand}"/>
                                <Button Content="Full scan" Margin="0,0,8,0"
                                        ToolTip="Every fixed drive. Takes a long time; you can keep working and stop it whenever you like."
                                        Command="{Binding FullScanCommand}"/>
                                <Button Content="Check startup items" Margin="0,0,8,0"
                                        Command="{Binding AuditStartupCommand}"/>
                                <Button Content="Check connections" Margin="0,0,8,0"
                                        Command="{Binding CheckConnectionsCommand}"/>
                                <Button Content="Check browser extensions" Margin="0,0,8,0"
                                        ToolTip="Lists the extensions installed in Chrome, Edge, Brave, Vivaldi and Opera, and what each one is allowed to do."
                                        Command="{Binding AuditExtensionsCommand}"/>
                                <Button Content="Check Windows security settings" Margin="0,0,8,0"
                                        ToolTip="Firewall, UAC, SmartScreen, Secure Boot, drive encryption and Windows Update. Reports how the machine is set up; changes nothing."
                                        Command="{Binding AuditPostureCommand}"/>
                                <Button Content="Check network settings" Margin="0,0,8,0"
                                        ToolTip="Checks the hosts file, proxy and DNS servers — the settings malware changes to cut you off from help."
                                        Command="{Binding AuditSystemSettingsCommand}"/>
                                <Button Content="Stop" Command="{Binding CancelScanCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Browser extensions">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="An extension that can read every page can read your bank session, and most people installed theirs years ago and forgot. Nothing on disk looks wrong, so no file scan will ever mention it. Nexus lists them and what they can do; removing one is done from your browser's own extensions page."/>

                            <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,6"
                                       Text="Not checked yet. Use &quot;Check browser extensions&quot; above."
                                       Visibility="{Binding ExtensionsNotChecked, Converter={StaticResource BoolToVisibility}}"/>

                            <ItemsControl ItemsSource="{Binding Extensions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#3A4256" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Version}"
                                                               Style="{StaticResource DimText}" Margin="8,0,0,0"/>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Where}"
                                                               Style="{StaticResource DimText}" Width="130"/>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Capabilities}" TextWrapping="Wrap"
                                                           Style="{StaticResource DimText}" Margin="130,2,0,0"
                                                           Visibility="{Binding HasCapabilities, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Scan history">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="What has actually been checked, and when. An empty findings list means nothing was found; it does not mean anything was looked at."/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Save report…" Margin="0,0,8,0"
                                        ToolTip="Writes the whole history to a text file you can paste somewhere when asking for help."
                                        Command="{Binding SaveReportCommand}"/>
                                <Button Content="Clear history" Command="{Binding ClearHistoryCommand}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,6"
                                       Text="Nothing has been scanned yet."
                                       Visibility="{Binding NothingScannedYet, Converter={StaticResource BoolToVisibility}}"/>

                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#3A4256" BorderThickness="0,0,0,1" Padding="0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}"
                                                           Style="{StaticResource DimText}" Margin="8,0,0,0"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}"
                                                           Style="{StaticResource DimText}" Width="110"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Outcome}" Style="{StaticResource DimText}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Files Nexus skips">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Anything listed here is not scanned at all. This is how you stop Nexus reporting your build output or a folder you already trust. Nexus will still tell you it skipped something rather than calling it clean."/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Width="300" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                         Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="A folder path, or an extension such as .log"/>
                                <Button Content="Browse…" Margin="0,0,8,0"
                                        Command="{Binding BrowseExclusionCommand}"/>
                                <Button Content="Skip this" Command="{Binding AddExclusionCommand}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,6"
                                       Text="Nothing is skipped yet. Everything Nexus can reach gets scanned."
                                       Visibility="{Binding SkipsNothing, Converter={StaticResource BoolToVisibility}}"/>

                            <ItemsControl ItemsSource="{Binding Exclusions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#3A4256" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Scan it again"
                                                            Command="{Binding DataContext.RemoveExclusionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Pattern}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource DimText}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap"
                                                           Foreground="#E2B341" Margin="0,4,0,0"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Findings">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Clear list" Command="{Binding ClearFindingsCommand}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#3A4256" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="Trust" Width="70" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.TrustCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Quarantine" Width="90"
                                                                IsEnabled="{Binding CanQuarantine}"
                                                                Command="{Binding DataContext.QuarantineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                    <TextBlock Width="150" Text="{Binding Level}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Width="60" VerticalAlignment="Center"
                                                               Text="{Binding Score, StringFormat={}{0}/100}"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Location}" Style="{StaticResource DimText}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Reasons}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Style="{StaticResource DimText}" Margin="0,2,0,0"
                                                           Text="{Binding Origin, StringFormat=found by: {0}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Files you have trusted">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Trusting a file stops Nexus warning about it, but it keeps analysing it and its findings stay visible. Trust follows the file's contents, so if it is ever modified or replaced the trust is dropped automatically. Nothing here is permanent — take it back at any time."/>
                            <ItemsControl ItemsSource="{Binding TrustedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Button DockPanel.Dock="Right" Content="Stop trusting" Width="100"
                                                    Command="{Binding DataContext.RevokeTrustCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Width="220" Text="{Binding Name}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding When}" Style="{StaticResource DimText}"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Quarantine">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Quarantined files are moved, never deleted, and every move is journalled before it happens so a crash cannot lose one. Put anything back with one click."/>
                            <ItemsControl ItemsSource="{Binding Quarantined}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Button DockPanel.Dock="Right" Content="Put back" Width="80"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Width="180" Text="{Binding Name}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Width="120" Text="{Binding When}" VerticalAlignment="Center"
                                                       Style="{StaticResource DimText}"/>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource DimText}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Latency & Hardware ================= -->
        <TabItem Header="Latency &amp; Hardware"
                 Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding Latency}" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,10"
                               Text="These settings target DPC/interrupt latency and timer behaviour. Most take effect after a reboot, several are hardware-specific, and gains vary a lot between systems — benchmark, and revert anything that doesn't help."/>

                    <GroupBox Header="Measure — before and after">
                        <StackPanel>
                            <TextBlock Text="{Binding MeasureStatus}" Style="{StaticResource DimText}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Capture baseline" Margin="0,0,8,0"
                                        Command="{Binding CaptureBaselineCommand}"/>
                                <Button Content="Measure and compare" Margin="0,0,8,0"
                                        Command="{Binding CompareCommand}"/>
                                <Button Content="Stop" Margin="0,0,8,0"
                                        Command="{Binding CancelMeasureCommand}"/>
                                <Button Content="Clear baselines"
                                        Command="{Binding ClearBaselinesCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BaselineSummary}" Style="{StaticResource DimText}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="What this measures: how late Windows is when it wakes a sleeping thread. It is a property of the system, not of any game — Nexus will not hook a game's render loop, because that is what cheats do and it gets accounts banned. Run both measurements under the same conditions or the comparison means nothing."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Is anything holding the CPU back?">
                        <StackPanel>
                            <TextBlock Text="{Binding MachineState}" Style="{StaticResource DimText}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="Check CPU speed limits" HorizontalAlignment="Left"
                                    Command="{Binding CheckMachineStateCommand}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Reads the enforced clock ceiling from the power subsystem. If the limit comes from your power plan, Nexus can fix it. If it comes from the firmware — heat, power delivery, a vendor setting — no software tweak will raise it, and Nexus will say so rather than sell you one."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="System timer resolution">
                        <StackPanel>
                            <CheckBox Content="Hold the finest timer resolution (≈0.5 ms)" IsChecked="{Binding HighTimerResolution}"/>
                            <TextBlock Text="{Binding TimerStatus}" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Boot timer settings (bcdedit — reboot required, each reversible)">
                        <ItemsControl ItemsSource="{Binding BootSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Apply" Width="60" Command="{Binding ApplyCommand}" Margin="0,0,4,0"/>
                                            <Button Content="Undo" Width="60" Command="{Binding UndoCommand}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="Interrupt tuning — MSI mode &amp; IRQ affinity (reboot to apply)">
                        <StackPanel>
                            <Button Content="Scan devices" Command="{Binding RefreshDevicesCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <ListView ItemsSource="{Binding Devices}" MaxHeight="260">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="MSI" Width="50">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding MsiEnabled}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Device" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Class" Width="90" DisplayMemberBinding="{Binding Class}"/>
                                        <GridViewColumn Header="State" Width="150" DisplayMemberBinding="{Binding State}"/>
                                        <GridViewColumn Header="Pin IRQ→CPU" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBox Text="{Binding PinCore}" Width="40" Margin="0,0,4,0"/>
                                                        <Button Content="Set" Command="{Binding PinCommand}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                                       Text="MSI (Message Signaled Interrupts) is usually beneficial on modern GPUs/NICs. Leave the pin box empty and Set to clear an affinity override."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Network adapter latency properties">
                        <StackPanel>
                            <TextBlock Text="{Binding NicStatus}" Style="{StaticResource DimText}" Margin="0,0,0,6"/>
                            <Button Content="Apply latency settings to all adapters" Command="{Binding ApplyNicLatencyCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Log ================= -->
        <TabItem Header="Log">
            <Grid Margin="10" DataContext="{Binding Log}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="260"
                             HorizontalAlignment="Left"/>
                </DockPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding Entries}" VirtualizingPanel.IsVirtualizing="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="150"
                                            DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"/>
                            <GridViewColumn Header="Level" Width="80" DisplayMemberBinding="{Binding Level}"/>
                            <GridViewColumn Header="Category" Width="110" DisplayMemberBinding="{Binding Category}"/>
                            <GridViewColumn Header="Message" Width="700" DisplayMemberBinding="{Binding Message}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>

        <!-- ================= Settings ================= -->
        <TabItem Header="Settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding Settings}" MaxWidth="640" HorizontalAlignment="Left">
                    <GroupBox Header="Security (Sentinel)">
                        <StackPanel>
                            <CheckBox Content="Watch process launches for suspicious behaviour"
                                      IsChecked="{Binding BehaviourMonitoring}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="20,2,0,8"
                                       Text="Costs one WMI subscription polled once a second. Turn off if you want zero background monitoring."/>

                            <CheckBox Content="Ransomware watch (plants hidden tripwire files)"
                                      IsChecked="{Binding RansomwareWatch}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="20,2,0,8"
                                       Text="This one writes real files into your Documents, Pictures, Videos, Music and Desktop folders. Turning it off removes them on the next start."/>

                            <CheckBox Content="Check new downloads as they arrive"
                                      IsChecked="{Binding ScanDownloads}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="20,2,0,8"
                                       Text="Scans programs and archives that appear in your Downloads folder, and only says something if there is something to say."/>

                            <CheckBox Content="Add &quot;Scan with Nexus&quot; to the right-click menu"
                                      IsChecked="{Binding ShellMenuEnabled}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="20,2,0,2"
                                       Text="Lets you right-click any file, folder or drive and check it. Written for your account only, so it needs no administrator rights, and unticking this removes it completely."/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="20,0,0,8"
                                       Text="{Binding ShellMenuStatus}"/>

                            <CheckBox Content="Look at USB drives when they are plugged in"
                                      IsChecked="{Binding ScanRemovableDrives}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="20,2,0,8"
                                       Text="Reads what is on a drive when it appears. The drive stays fully usable while this runs, and nothing on it is opened, moved or changed. Stops after 20,000 files and tells you if it did."/>

                            <CheckBox Content="Re-check download and startup folders every few hours"
                                      IsChecked="{Binding ScheduledQuickScan}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="20,2,0,8"
                                       Text="Checks where new files actually arrive, rather than crawling the whole disk. Never runs while a game is active, and stays silent unless it finds something."/>

                            <CheckBox Content="Run a full scan every week when the machine is idle"
                                      IsChecked="{Binding ScheduledFullScan}"/>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="20,2,0,8"
                                       Text="Off by default, unlike the other watches. Nexus exists to keep this machine responsive, and a surprise full scan chewing the disk is the behaviour it was built to prevent. Switched on, it waits until you have been away for ten minutes, never runs while a game is on, and pauses the moment you come back."/>

                            <CheckBox Content="Check Microsoft Defender's health at startup"
                                      IsChecked="{Binding CheckDefenderHealth}"/>

                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="These take effect the next time Nexus starts. Stopping a running monitor halfway would leave it looking active while reporting nothing, which is worse than waiting."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="ProBalance thresholds">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Engage above total CPU %" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LoadEnterPct}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Release below total CPU %" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LoadExitPct}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Load must persist (ms)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SustainMs}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Calm must persist (ms)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ReleaseMs}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Text="Minimum restraint time (ms)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MinRestraintMs}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Text="Per-process CPU threshold %" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ProcessCpuThresholdPct}" Margin="0,2"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="ProBalance exclusions (comma-separated exe names)">
                        <TextBox Text="{Binding ProBalanceExclusions}"/>
                    </GroupBox>
                    <GroupBox Header="IdleSaver">
                        <StackPanel>
                            <CheckBox Content="Switch to Power Saver when idle" IsChecked="{Binding IdleSaverEnabled}"/>
                            <DockPanel>
                                <TextBlock Text="Idle minutes:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding IdleMinutes}" Width="60" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="SmartTrim">
                        <StackPanel>
                            <CheckBox Content="Periodically trim background working sets" IsChecked="{Binding SmartTrimEnabled}"/>
                            <DockPanel>
                                <TextBlock Text="Only processes above (MB):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding TrimThresholdMb}" Width="60" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Every (minutes):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding TrimIntervalMinutes}" Width="60" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="General">
                        <StackPanel>
                            <CheckBox Content="Foreground boosting (raise the app you're using to AboveNormal)" IsChecked="{Binding ForegroundBoost}"/>
                            <CheckBox Content="Keep the PC awake (block sleep and display off)" IsChecked="{Binding KeepAwake}"/>
                            <CheckBox Content="Start with Windows (scheduled task, highest privileges)" IsChecked="{Binding StartWithWindows}"/>
                        </StackPanel>
                    </GroupBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <Button Content="Run setup wizard…"
                                Command="{Binding DataContext.OpenWizardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,0,8,0"/>
                        <Button Content="Restore ALL defaults (undo every tweak, rule and power change)…"
                                Command="{Binding DataContext.RestoreDefaultsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
