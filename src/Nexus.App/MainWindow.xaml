<Window x:Class="Nexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nexus.App.Controls"
        Title="Nexus Optimizer" Height="760" Width="1180"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: app name + mode switch -->
        <DockPanel Grid.Row="0" Margin="12,10,12,0" LastChildFill="False">
            <TextBlock Text="Nexus" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                    Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="{Binding ModeLabel}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Button DockPanel.Dock="Right" Content="{Binding ModeButtonText}" Command="{Binding ToggleModeCommand}"
                    VerticalAlignment="Center"/>
        </DockPanel>

    <TabControl Grid.Row="1" x:Name="Tabs" Margin="8">

        <!-- ================= Dashboard ================= -->
        <TabItem Header="Dashboard">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="10" DataContext="{Binding Dashboard}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource H1}">
                            <Run Text="CPU "/><Run Text="{Binding CpuText, Mode=OneWay}"/>
                        </TextBlock>
                        <controls:SparklineControl Values="{Binding CpuHistory}" Height="120"
                                                   Stroke="{StaticResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource H1}" Margin="0,16,0,8">
                            <Run Text="RAM "/><Run Text="{Binding RamText, Mode=OneWay}"/>
                        </TextBlock>
                        <controls:SparklineControl Values="{Binding RamHistory}" Height="120"
                                                   Stroke="{StaticResource AccentAltBrush}"/>
                        <TextBlock Style="{StaticResource H1}" Margin="0,16,0,8" Text="Per-core load"/>
                        <controls:CoreBarsControl Values="{Binding PerCore}" ECoreMask="{Binding ECoreMask}" Height="90"/>
                        <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                                   Text="Blue bars are P-cores/standard cores, green bars are E-cores."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <GroupBox Header="System optimization rating">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="64" Height="64" CornerRadius="10" Background="{StaticResource PanelAltBrush}">
                                        <TextBlock Text="{Binding RatingGrade}" FontSize="30" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="20" FontWeight="SemiBold">
                                            <Run Text="{Binding RatingScore, Mode=OneWay}"/><Run Text=" / 100" Foreground="{StaticResource TextDimBrush}" FontSize="13"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RatingSummary}" Style="{StaticResource DimText}" MaxWidth="220"/>
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding RatingCategories}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Category}" FontSize="11.5" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="1" Value="{Binding Score, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat={}{0}%}" FontSize="11" TextAlignment="Right"
                                                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Open setup wizard" Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Command="{Binding DataContext.OpenWizardCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Suggested optimizations"
                                  DataContext="{Binding DataContext.Suggestions, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Re-scan" Command="{Binding RefreshCommand}"/>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Width="70" VerticalAlignment="Top"
                                                            Content="{Binding ActionText}" Command="{Binding ApplyCommand}"
                                                            Visibility="{Binding Actionable, Converter={StaticResource BoolToVisibility}}"/>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource DimText}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="System">
                            <StackPanel>
                                <TextBlock Text="{Binding TopologyText}"/>
                                <TextBlock Text="{Binding RulesText}" Margin="0,4,0,0"/>
                                <CheckBox Content="ProBalance (dynamic restraint)"
                                          IsChecked="{Binding ProBalanceEnabled}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Currently restrained">
                            <ListBox ItemsSource="{Binding Restrained}" MinHeight="120" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding ExeName, Mode=OneWay}"/>
                                            <Run Text="{Binding Pid, Mode=OneWay, StringFormat=' (PID {0})'}"
                                                 Foreground="{StaticResource TextDimBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Processes ================= -->
        <TabItem Header="Processes"
                 Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="10" DataContext="{Binding Processes}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220"
                             HorizontalAlignment="Left"/>
                </DockPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding Selected}"
                          VirtualizingPanel.IsVirtualizing="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Process" Width="260" DisplayMemberBinding="{Binding ExeName}"/>
                            <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                            <GridViewColumn Header="CPU %" Width="80" DisplayMemberBinding="{Binding Cpu}"/>
                            <GridViewColumn Header="RAM (MB)" Width="100" DisplayMemberBinding="{Binding RamMb}"/>
                            <GridViewColumn Header="Rule" Width="60" DisplayMemberBinding="{Binding HasRule}"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Set priority (now)">
                                <MenuItem Header="Idle" Command="{Binding SetPriorityCommand}" CommandParameter="Idle"/>
                                <MenuItem Header="Below normal" Command="{Binding SetPriorityCommand}" CommandParameter="BelowNormal"/>
                                <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="Normal"/>
                                <MenuItem Header="Above normal" Command="{Binding SetPriorityCommand}" CommandParameter="AboveNormal"/>
                                <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="High"/>
                            </MenuItem>
                            <MenuItem Header="Set priority (always)">
                                <MenuItem Header="Idle" Command="{Binding SetPriorityAlwaysCommand}" CommandParameter="Idle"/>
                                <MenuItem Header="Below normal" Command="{Binding SetPriorityAlwaysCommand}" CommandParameter="BelowNormal"/>
                                <MenuItem Header="Normal" Command="{Binding SetPriorityAlwaysCommand}" CommandParameter="Normal"/>
                                <MenuItem Header="Above normal" Command="{Binding SetPriorityAlwaysCommand}" CommandParameter="AboveNormal"/>
                                <MenuItem Header="High" Command="{Binding SetPriorityAlwaysCommand}" CommandParameter="High"/>
                            </MenuItem>
                            <MenuItem Header="Restrict cores (now)">
                                <MenuItem Header="P-cores only" Command="{Binding SetAffinityCommand}" CommandParameter="PCoresOnly"/>
                                <MenuItem Header="E-cores only" Command="{Binding SetAffinityCommand}" CommandParameter="ECoresOnly"/>
                                <MenuItem Header="Physical cores only" Command="{Binding SetAffinityCommand}" CommandParameter="PhysicalCoresOnly"/>
                            </MenuItem>
                            <MenuItem Header="Restrict cores (always)">
                                <MenuItem Header="P-cores only" Command="{Binding SetAffinityAlwaysCommand}" CommandParameter="PCoresOnly"/>
                                <MenuItem Header="E-cores only" Command="{Binding SetAffinityAlwaysCommand}" CommandParameter="ECoresOnly"/>
                                <MenuItem Header="Physical cores only" Command="{Binding SetAffinityAlwaysCommand}" CommandParameter="PhysicalCoresOnly"/>
                            </MenuItem>
                            <MenuItem Header="IO priority (now)">
                                <MenuItem Header="Very low" Command="{Binding SetIoPriorityCommand}" CommandParameter="VeryLow"/>
                                <MenuItem Header="Low" Command="{Binding SetIoPriorityCommand}" CommandParameter="Low"/>
                                <MenuItem Header="Normal" Command="{Binding SetIoPriorityCommand}" CommandParameter="Normal"/>
                            </MenuItem>
                            <MenuItem Header="Efficiency mode on" Command="{Binding SetEfficiencyCommand}" CommandParameter="on"/>
                            <MenuItem Header="Efficiency mode off" Command="{Binding SetEfficiencyCommand}" CommandParameter="off"/>
                            <MenuItem Header="Limit CPU to…">
                                <MenuItem Header="10%" Command="{Binding LimitCpuCommand}" CommandParameter="10"/>
                                <MenuItem Header="25%" Command="{Binding LimitCpuCommand}" CommandParameter="25"/>
                                <MenuItem Header="50%" Command="{Binding LimitCpuCommand}" CommandParameter="50"/>
                                <MenuItem Header="75%" Command="{Binding LimitCpuCommand}" CommandParameter="75"/>
                                <MenuItem Header="Remove CPU limit" Command="{Binding ClearCpuLimitCommand}"/>
                            </MenuItem>
                            <MenuItem Header="Launch priority (survives anti-cheat)">
                                <MenuItem Header="High" Command="{Binding SetLaunchPriorityCommand}" CommandParameter="High"/>
                                <MenuItem Header="Above normal" Command="{Binding SetLaunchPriorityCommand}" CommandParameter="AboveNormal"/>
                                <MenuItem Header="Below normal" Command="{Binding SetLaunchPriorityCommand}" CommandParameter="BelowNormal"/>
                                <MenuItem Header="Idle" Command="{Binding SetLaunchPriorityCommand}" CommandParameter="Idle"/>
                                <MenuItem Header="Remove launch priority" Command="{Binding ClearLaunchPriorityCommand}"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Trim working set" Command="{Binding TrimCommand}"/>
                            <MenuItem Header="Remove saved rule" Command="{Binding RemoveRuleCommand}"/>
                            <Separator/>
                            <MenuItem Header="Terminate…" Command="{Binding KillCommand}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Grid>
        </TabItem>

        <!-- ================= Game Mode ================= -->
        <TabItem Header="Game Mode">
            <Grid Margin="10" DataContext="{Binding GameMode}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource H1}" Text="{Binding StatusText}"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Game Mode enabled" IsChecked="{Binding Enabled}" Margin="0,0,16,0"/>
                        <CheckBox Content="Auto-detect fullscreen/borderless games" IsChecked="{Binding AutoDetect}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <Button Content="Force Game Mode for current app" Command="{Binding ForceCommand}" Margin="0,0,8,0"/>
                        <Button Content="End Game Mode" Command="{Binding EndCommand}"/>
                    </StackPanel>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,4,0,8">
                    <TextBlock Text="Add game exe:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddGameCommand}" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding NewGameExe, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <ListView Grid.Row="2" ItemsSource="{Binding Games}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Game" Width="200" DisplayMemberBinding="{Binding ExeName}"/>
                            <GridViewColumn Header="Rating" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding RatingDetail}">
                                            <Border Width="26" Height="20" CornerRadius="5" Background="{StaticResource PanelAltBrush}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding RatingGrade}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding RatingScore, StringFormat={}{0}/100}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextDimBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Enabled" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Soft pinning (CPU sets)" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding UseCpuSets}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Demote hogs" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DemoteBackgroundHogs}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Perf. power plan" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding UsePerformancePowerPlan}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Pause Windows Update" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding PauseWindowsUpdate}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"
                                                Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>

        <!-- ================= Tweaks ================= -->
        <TabItem Header="Tweaks — measure before trusting">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding Tweaks}">
                    <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,10"
                               Text="Every tweak backs up the registry keys it touches (plus a System Restore point once per session) and has a working Undo. The descriptions are honest — benchmark before and after instead of trusting labels."/>

                    <GroupBox Header="System tweaks">
                        <ItemsControl ItemsSource="{Binding Tweaks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Width="70" Content="{Binding ButtonText}"
                                                    Command="{Binding ToggleCommand}" VerticalAlignment="Top"/>
                                            <StackPanel Margin="0,0,10,0">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding EffectivenessLabel}" Style="{StaticResource DimText}"
                                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <Border Width="7" Height="13" CornerRadius="2" Margin="1,0"
                                                                Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=1}"/>
                                                        <Border Width="7" Height="13" CornerRadius="2" Margin="1,0"
                                                                Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=2}"/>
                                                        <Border Width="7" Height="13" CornerRadius="2" Margin="1,0"
                                                                Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=3}"/>
                                                        <Border Width="7" Height="13" CornerRadius="2" Margin="1,0"
                                                                Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=4}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Pros}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource AccentAltBrush}" FontSize="11" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Cons}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource WarnBrush}" FontSize="11"/>
                                                </Grid>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="Debloat — services (disable only, reversible)"
                              Visibility="{Binding DataContext.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Width="80" Content="{Binding ButtonText}"
                                                Command="{Binding ToggleCommand}" VerticalAlignment="Top"/>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="Debloat — telemetry scheduled tasks (disable only, reversible)"
                              Visibility="{Binding DataContext.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Width="80" Content="{Binding ButtonText}"
                                                Command="{Binding ToggleCommand}" VerticalAlignment="Top"/>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="Debloat — preinstalled apps (removal is one-way; nothing is pre-checked)"
                              Visibility="{Binding DataContext.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Checked}">
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding PackageFamily, Mode=OneWay, StringFormat=' ({0})'}"
                                                     Foreground="{StaticResource TextDimBrush}"/>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Remove checked apps…" Command="{Binding RemoveCheckedAppsCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Cleaner — size preview, then confirm">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Scan" Command="{Binding ScanCommand}" Margin="0,0,8,0"/>
                                <Button Content="Clean checked…" Command="{Binding CleanCommand}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding CleanerStatus}" VerticalAlignment="Center"
                                           Style="{StaticResource DimText}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding CleanTargets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Checked}">
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding SizeText, Mode=OneWay, StringFormat=' — {0}'}"
                                                     Foreground="{StaticResource TextDimBrush}"/>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Startup manager (enable/disable only — nothing is deleted)"
                              Visibility="{Binding DataContext.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Button Content="Refresh" Command="{Binding RefreshStartupCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <ListView ItemsSource="{Binding StartupEntries}" MaxHeight="320">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Enabled" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Source" Width="140" DisplayMemberBinding="{Binding Source}"/>
                                        <GridViewColumn Header="Command / path" Width="420" DisplayMemberBinding="{Binding Command}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Memory & Network ================= -->
        <TabItem Header="Memory &amp; Network">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding Tools}" MaxWidth="760" HorizontalAlignment="Left">
                    <GroupBox Header="Standby memory list">
                        <StackPanel>
                            <TextBlock Text="{Binding MemoryStatus}" Style="{StaticResource DimText}" Margin="0,0,0,8"/>
                            <Button Content="Purge standby list now" Command="{Binding PurgeStandbyCommand}"
                                    HorizontalAlignment="Left"/>
                            <CheckBox Content="Auto-purge when free memory is low" IsChecked="{Binding AutoPurgeStandby}"
                                      Margin="0,8,0,0"/>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Purge below free RAM (MB):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding FreeMemoryThresholdMb}" Width="70" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="DNS benchmark &amp; switch (reversible)">
                        <StackPanel>
                            <TextBlock Text="{Binding DnsStatus}" Style="{StaticResource DimText}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Benchmark resolvers" Command="{Binding BenchmarkDnsCommand}" Margin="0,0,8,0"/>
                                <Button Content="Restore previous DNS" Command="{Binding RestoreDnsCommand}"
                                        IsEnabled="{Binding CanRestoreDns}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DnsResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Button DockPanel.Dock="Right" Content="Use" Width="60"
                                                    Command="{Binding DataContext.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Width="110" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Width="120" Text="{Binding Latency}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Servers}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Latency & Hardware ================= -->
        <TabItem Header="Latency &amp; Hardware"
                 Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding Latency}" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,10"
                               Text="These settings target DPC/interrupt latency and timer behaviour. Most take effect after a reboot, several are hardware-specific, and gains vary a lot between systems — benchmark, and revert anything that doesn't help."/>

                    <GroupBox Header="System timer resolution">
                        <StackPanel>
                            <CheckBox Content="Hold the finest timer resolution (≈0.5 ms)" IsChecked="{Binding HighTimerResolution}"/>
                            <TextBlock Text="{Binding TimerStatus}" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Boot timer settings (bcdedit — reboot required, each reversible)">
                        <ItemsControl ItemsSource="{Binding BootSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Apply" Width="60" Command="{Binding ApplyCommand}" Margin="0,0,4,0"/>
                                            <Button Content="Undo" Width="60" Command="{Binding UndoCommand}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="Interrupt tuning — MSI mode &amp; IRQ affinity (reboot to apply)">
                        <StackPanel>
                            <Button Content="Scan devices" Command="{Binding RefreshDevicesCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <ListView ItemsSource="{Binding Devices}" MaxHeight="260">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="MSI" Width="50">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding MsiEnabled}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Device" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Class" Width="90" DisplayMemberBinding="{Binding Class}"/>
                                        <GridViewColumn Header="State" Width="150" DisplayMemberBinding="{Binding State}"/>
                                        <GridViewColumn Header="Pin IRQ→CPU" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBox Text="{Binding PinCore}" Width="40" Margin="0,0,4,0"/>
                                                        <Button Content="Set" Command="{Binding PinCommand}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                                       Text="MSI (Message Signaled Interrupts) is usually beneficial on modern GPUs/NICs. Leave the pin box empty and Set to clear an affinity override."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Network adapter latency properties">
                        <StackPanel>
                            <TextBlock Text="{Binding NicStatus}" Style="{StaticResource DimText}" Margin="0,0,0,6"/>
                            <Button Content="Apply latency settings to all adapters" Command="{Binding ApplyNicLatencyCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Log ================= -->
        <TabItem Header="Log">
            <Grid Margin="10" DataContext="{Binding Log}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="260"
                             HorizontalAlignment="Left"/>
                </DockPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding Entries}" VirtualizingPanel.IsVirtualizing="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="150"
                                            DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"/>
                            <GridViewColumn Header="Level" Width="80" DisplayMemberBinding="{Binding Level}"/>
                            <GridViewColumn Header="Category" Width="110" DisplayMemberBinding="{Binding Category}"/>
                            <GridViewColumn Header="Message" Width="700" DisplayMemberBinding="{Binding Message}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>

        <!-- ================= Settings ================= -->
        <TabItem Header="Settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding Settings}" MaxWidth="640" HorizontalAlignment="Left">
                    <GroupBox Header="ProBalance thresholds">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Engage above total CPU %" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LoadEnterPct}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Release below total CPU %" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LoadExitPct}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Load must persist (ms)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SustainMs}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Calm must persist (ms)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ReleaseMs}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Text="Minimum restraint time (ms)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MinRestraintMs}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Text="Per-process CPU threshold %" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ProcessCpuThresholdPct}" Margin="0,2"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="ProBalance exclusions (comma-separated exe names)">
                        <TextBox Text="{Binding ProBalanceExclusions}"/>
                    </GroupBox>
                    <GroupBox Header="IdleSaver">
                        <StackPanel>
                            <CheckBox Content="Switch to Power Saver when idle" IsChecked="{Binding IdleSaverEnabled}"/>
                            <DockPanel>
                                <TextBlock Text="Idle minutes:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding IdleMinutes}" Width="60" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="SmartTrim">
                        <StackPanel>
                            <CheckBox Content="Periodically trim background working sets" IsChecked="{Binding SmartTrimEnabled}"/>
                            <DockPanel>
                                <TextBlock Text="Only processes above (MB):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding TrimThresholdMb}" Width="60" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Every (minutes):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding TrimIntervalMinutes}" Width="60" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="General">
                        <StackPanel>
                            <CheckBox Content="Foreground boosting (raise the app you're using to AboveNormal)" IsChecked="{Binding ForegroundBoost}"/>
                            <CheckBox Content="Keep the PC awake (block sleep and display off)" IsChecked="{Binding KeepAwake}"/>
                            <CheckBox Content="Start with Windows (scheduled task, highest privileges)" IsChecked="{Binding StartWithWindows}"/>
                        </StackPanel>
                    </GroupBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <Button Content="Run setup wizard…"
                                Command="{Binding DataContext.OpenWizardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,0,8,0"/>
                        <Button Content="Restore ALL defaults (undo every tweak, rule and power change)…"
                                Command="{Binding DataContext.RestoreDefaultsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
