<Window x:Class="Nexus.App.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus — Setup wizard" Height="640" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <TextBlock Text="{Binding StepProgress}" Style="{StaticResource DimText}" FontSize="11"/>
            <TextBlock Text="{Binding StepTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <TextBlock Text="{Binding StepSubtitle}" Style="{StaticResource DimText}"/>
            <ProgressBar Value="{Binding ProgressFraction, Mode=OneWay}" Maximum="1" Height="4" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,6,24,6">
            <Grid>
                <!-- Welcome -->
                <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                               Text="Nexus will look at your CPU, current tweaks and services, then recommend the optimizations that actually matter — ranked by real effectiveness, each with its pros and cons. You choose what to apply; a System Restore point and registry backups are taken first, and everything can be undone."/>
                </StackPanel>

                <!-- Scan -->
                <StackPanel Visibility="{Binding IsScan, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="72" Height="72" CornerRadius="10" Background="{StaticResource PanelAltBrush}">
                                <TextBlock Text="{Binding BeforeGrade}" FontSize="34" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold">
                                    <Run Text="Current system rating: "/><Run Text="{Binding BeforeScore, Mode=OneWay}"/><Run Text=" / 100"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                                           Text="This measures how many high-value optimizations are already active — not a benchmark. The next step shows what would raise it."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Recommendations -->
                <StackPanel Visibility="{Binding IsRecommendations, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Checked}" VerticalAlignment="Top"
                                                  IsEnabled="{Binding Actionable}" Margin="0,2,12,0"/>
                                        <StackPanel>
                                            <DockPanel>
                                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding EffectivenessBars}" Visibility="Collapsed"/>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding EffectivenessLabel}" Style="{StaticResource DimText}"
                                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Border Width="8" Height="14" CornerRadius="2" Margin="1,0" Background="{StaticResource AccentBrush}"/>
                                                    <Border Width="8" Height="14" CornerRadius="2" Margin="1,0"
                                                            Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=2}"/>
                                                    <Border Width="8" Height="14" CornerRadius="2" Margin="1,0"
                                                            Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=3}"/>
                                                    <Border Width="8" Height="14" CornerRadius="2" Margin="1,0"
                                                            Background="{Binding EffectivenessBars, Converter={StaticResource BarsToBrush}, ConverterParameter=4}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Pros}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource AccentAltBrush}" FontSize="11.5" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Cons}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource WarnBrush}" FontSize="11.5"/>
                                            </Grid>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="2,4,0,0"
                               Text="Bars show honest average impact: 1 = situational, 4 = consistently worthwhile."/>
                </StackPanel>

                <!-- Games -->
                <StackPanel Visibility="{Binding IsGames, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="8"
                                                Background="{StaticResource PanelAltBrush}" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Grade}" FontSize="22" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExeName}" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource DimText}" FontSize="11.5">
                                                <Run Text="Profile rating "/><Run Text="{Binding Score, Mode=OneWay}"/><Run Text=" / 100"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource DimText}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource DimText}" Text="No games yet — add them on the Game Mode tab and they'll be rated here."
                               Visibility="{Binding Games.Count, Converter={StaticResource ZeroToVisibility}}"/>
                </StackPanel>

                <!-- Apply -->
                <StackPanel Visibility="{Binding IsApply, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                               Text="Click Next to apply the optimizations you left checked. A System Restore point and per-key registry backups are taken first, and each change remains individually reversible."/>
                </StackPanel>

                <!-- Finish -->
                <StackPanel Visibility="{Binding IsFinish, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding BeforeScore}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Text="  →  " FontSize="20" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Text="{Binding AfterScore}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentAltBrush}"/>
                                <TextBlock Text="  / 100" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ApplySummary}" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Back" Width="90" Command="{Binding BackCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Next" Width="110" Command="{Binding NextCommand}"
                            Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <Button Content="Finish" Width="110" Command="{Binding FinishCommand}"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
