<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Nexus</AssemblyName>
    <RootNamespace>Nexus.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WFAC010: WinForms analyzer objects to manifest DPI settings; this is a WPF app
         (WinForms is referenced only for NotifyIcon) and WPF reads DPI from the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWindowsForms injects these as global usings, which makes half of WPF's
         type names (Brush, Point, MessageBox, Timer…) ambiguous. WinForms is only
         used inside TrayIconService, which qualifies its types explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.6" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
    <!-- Build order only. The scanner is a separate *process*, deliberately not a
         referenced assembly: the whole point of it is that its code never runs
         inside this elevated process. -->
    <ProjectReference Include="..\Nexus.Scanner\Nexus.Scanner.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Detection data lives beside the executable, not in %APPDATA%: keeping it out
         of a user-writable directory means a non-admin cannot swap the rules. -->
    <Content Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Put Nexus.Scanner.exe beside Nexus.exe, which is where ScannerHost looks for
       it. If it is missing, Sentinel drops file scanning and says so rather than
       failing silently. -->
  <Target Name="CopyScannerWorker" AfterTargets="Build">
    <ItemGroup>
      <ScannerOutput Include="$(MSBuildThisFileDirectory)..\Nexus.Scanner\bin\$(Configuration)\net8.0\Nexus.Scanner.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ScannerOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildThisFileDirectory)..\Nexus.Scanner\bin\$(Configuration)\net8.0')" />
  </Target>

  <!-- Publish is a separate pipeline from Build, so the copy above does NOT cover it:
       without this target the shipped folder contains no scanner at all and file
       scanning is silently absent from the product.

       The worker is published self-contained because Nexus.exe is: the runtime bundled
       inside a single-file host is not usable by a second executable, so a
       framework-dependent worker would fail to start on any machine without .NET
       installed — exactly the machines self-contained publishing exists to serve.
       Trimmed, it costs about 15 MB rather than the full 60. -->
  <Target Name="PublishScannerWorker" AfterTargets="Publish">
    <PropertyGroup>
      <ScannerStagingDir>$(MSBuildThisFileDirectory)obj\scanner-publish\$(Configuration)\</ScannerStagingDir>
    </PropertyGroup>

    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Nexus.Scanner\Nexus.Scanner.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishTrimmed=true;PublishDir=$(ScannerStagingDir)" />

    <ItemGroup>
      <ScannerPublished Include="$(ScannerStagingDir)Nexus.Scanner.exe" />
    </ItemGroup>

    <Copy SourceFiles="@(ScannerPublished)" DestinationFolder="$(PublishDir)" />

    <!-- Fail the publish rather than shipping a build whose scanner is missing.
         A silently disabled engine is the worst outcome: the product looks complete
         and reports "unknown" on everything it should have had an opinion about. -->
    <Error Condition="!Exists('$(PublishDir)Nexus.Scanner.exe')" Text="Nexus.Scanner.exe was not published. Sentinel would ship without file scanning." />
  </Target>
</Project>
